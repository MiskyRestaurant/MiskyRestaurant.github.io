# ===== Variables de PRODUCCIÓN =====
# En el servidor: copia este archivo a .env  ->  cp .env.prod.example .env
# y reemplaza TODOS los valores. Nunca subas el .env real al repositorio.

# Tu dominio (sin http://). Ej: miskyrestaurant.com
DOMAIN=tudominio.com

# --- Base de datos PostgreSQL ---
POSTGRES_USER=misky
POSTGRES_DB=misky
# Contraseña fuerte de la BD. Genera una con: openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA

# --- Seguridad de la app ---
# Secreto para firmar la sesión del admin. Genera uno con: openssl rand -base64 32
AUTH_SECRET=CAMBIA_ESTE_SECRETO_LARGO_Y_ALEATORIO

# --- Credenciales iniciales del administrador (las aplica el seed) ---
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_ADMIN
