# Copia este archivo a .env y ajusta los valores.

# PostgreSQL. En host: localhost. Dentro de docker-compose, la app usa host "db".
DATABASE_URL="postgresql://misky:misky_secret@localhost:5544/misky?schema=public"

# Secreto para firmar la sesión del admin (usa una cadena larga y aleatoria en producción)
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Credenciales iniciales del administrador (las aplica el seed)
ADMIN_EMAIL="admin@misky.pe"
ADMIN_PASSWORD="misky2026"
