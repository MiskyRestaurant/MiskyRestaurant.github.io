// Misky Peruvian Cuisines — esquema de base de datos
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Categorías de la carta: Entradas, Platos de fondo, Del mar, Bebidas, Postres
model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  order     Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())
}

/// Un plato de la carta
model MenuItem {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  image       String?
  featured    Boolean  @default(false)
  available   Boolean  @default(true)
  spicy       Boolean  @default(false)
  order       Int      @default(0)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Solicitudes de reserva enviadas desde la web
model Reservation {
  id        Int               @id @default(autoincrement())
  name      String
  email     String
  phone     String
  date      String // YYYY-MM-DD
  time      String // HH:mm
  guests    Int
  notes     String?
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/// Usuario del panel de administración
model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String // hash bcrypt
  name      String   @default("Administrador")
  createdAt DateTime @default(now())
}
